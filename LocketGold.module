#!name=Locket Gold All-in-One (San)
#!desc=Mở khóa Locket Gold, Up Video, Đăng riêng tư & Full Captions

[Script]
# 1. Xóa ETag ở luồng Request
Locket_Delete_ETag = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/TTSan1208/TTS1280/refs/heads/main/locket_san.js,timeout=60

# 2. Bơm gói Gold ở luồng Response RevenueCat
Locket_Gold_Response = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/TTSan1208/TTS1280/refs/heads/main/locket_san.js,timeout=60

# 3. Mở khóa Captions, Video & Đăng riêng tư ở luồng Firebase
Locket_Firebase_Config = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-img\/namespaces\/firebase:fetch,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/TTSan1208/TTS1280/refs/heads/main/locket_san.js,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
